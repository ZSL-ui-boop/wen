# 使用方式：复制本文件为同目录下的 application-local.yml，填写 password 后重启后端。
# application-local.yml 已在仓库 .gitignore 中，不会被提交。
#
# QQ 授权码获取：mail.qq.com → 设置 → 账户 → 开启 SMTP → 生成授权码（不是 QQ 登录密码）
#
# AI 助手（OpenAI 兼容：OpenAI / DeepSeek / 通义等）也可用环境变量：AI_ENABLED、AI_API_KEY、AI_BASE_URL、AI_MODEL
# ai:
#   enabled: true
#   base-url: https://api.deepseek.com/v1
#   api-key: sk-xxx
#   model: deepseek-chat
#
spring:
  mail:
    enable: true
    username: 你的QQ号@qq.com
    password: 在此填写SMTP授权码
    form: "Free-Fs <你的QQ号@qq.com>"
